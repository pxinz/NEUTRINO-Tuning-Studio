{
  "name": "neutrino-tuning-studio",
  "version": "1.1.1",
  "description": "A complete cross-platform tuning GUI for NEUTRINO Tau",
  "main": "electron/main.cjs",
  "author": {
    "name": "NEUTRINO Tuning Studio contributors",
    "email": "noreply@neutrino-tools.invalid"
  },
  "homepage": "https://studio-neutrino.com/",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -s first -n VITE,APP -c cyan,magenta \"vite --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env NT_DEV=1 electron .\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "icon": "node scripts/make-icon.cjs",
    "test": "vitest run",
    "test:e2e:win": "node scripts/e2e-main.cjs",
    "test:e2e:ui": "node scripts/e2e-ui-fixes.cjs",
    "test:e2e:phrase": "node scripts/e2e-phrase.cjs",
    "test:e2e:linux": "node scripts/linux-smoke.cjs",
    "screenshots": "node scripts/final-shots.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.1",
    "i18next": "^25.6.2",
    "lucide-react": "^0.548.0",
    "midi-file": "^1.2.4",
    "pako": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.studio.neutrino.tuningstudio",
    "productName": "NEUTRINO Tuning Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NEUTRINO Tuning Studio"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icons",
      "executableName": "neutrino-tuning-studio",
      "maintainer": "NEUTRINO Tuning Studio contributors <noreply@neutrino-tools.invalid>",
      "synopsis": "NEUTRINO Tau tuning studio",
      "description": "A cross-platform score, timing, pitch and dynamics editor for NEUTRINO Tau."
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    }
  }
}
